# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to git!

# ==========================================
# 📊 DATABASE CONFIGURATION
# ==========================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?sslmode=require
# Get from: Render.com, Railway.app, or your own PostgreSQL server
DATABASE_URL=postgresql://user:password@host:5432/skinglow?sslmode=require

# ==========================================
# 📧 EMAIL CONFIGURATION (Gmail)
# ==========================================
# Gmail address for sending emails (contact form, OTP, etc.)
GMAIL_USER=your_email@gmail.com

# Gmail App-Specific Password (NOT your regular password!)
# Generate from: https://support.google.com/accounts/answer/185833
GMAIL_PASS=xxxx xxxx xxxx xxxx

# ==========================================
# 🔐 AUTHENTICATION
# ==========================================
# JWT Secret - Use a strong random string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_very_secure_random_string_here_at_least_32_characters

# ==========================================
# 🤖 AI & API KEYS
# ==========================================
# Google Generative AI (Gemini API)
GOOGLE_GENAI_API_KEY=your_google_genai_api_key

# Groq API (optional, for faster AI inference)
GROQ_API_KEY=your_groq_api_key

# ==========================================
# 💳 PAYMENT GATEWAY
# ==========================================
# Stripe Secret Key (for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# ==========================================
# 🔄 WORKFLOW & AUTOMATION
# ==========================================
# N8N Webhook for order automation
N8N_WEBHOOK_URL=https://your_n8n_instance.com/webhook/orders

# ==========================================
# 🌐 FRONTEND
# ==========================================
# API URL for frontend to use in production
# On Appwrite: Use your Appwrite domain
# On Vercel: Use your Vercel domain
VITE_API_URL=https://your_appwrite_domain.appwrite.io

# ==========================================
# 🛠️ ENVIRONMENT
# ==========================================
# Environment: development, production, staging
NODE_ENV=production

# ==========================================
# 🔍 OPTIONAL - DEBUGGING
# ==========================================
# Set to true for more verbose logging
DEBUG=false
LOG_LEVEL=info
